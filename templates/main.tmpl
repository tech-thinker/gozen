package main

import (
	"context"
	"os"
	"sync"

	"github.com/spf13/viper"
	"{{.PackageName}}/config"
	"{{.PackageName}}/constants"
	"{{.PackageName}}/instance"
	"{{.PackageName}}/logger"
	"{{.PackageName}}/runner"
	"{{.PackageName}}/utils"
	"github.com/urfave/cli"
)

func main() {
	v := viper.New()
	cfg := config.Init(v)

	logLevel := logger.LevelDebug
	if cfg.AppEnv() == constants.APP_ENV_PRODUCTION {
		logLevel = logger.LevelInfo
	}

	logger.Setup(logger.LogConfig{
		ServiceName: cfg.AppName(),
		LogLevel:    logLevel,
		IsJson:      true,
		AddSource:   true,
		Output:      os.Stdout,
	})

	// initializing singleton
	singleton := instance.Init(cfg)

	// CLI app
	clientApp := cli.NewApp()
	clientApp.Name = "{{.AppName}}"
	clientApp.Version = cfg.Version()
	clientApp.Commands = []cli.Command{
		{
			Name:  "start",
			Usage: "Start the service",
			Action: func(c *cli.Context) error {
				var wg sync.WaitGroup
				utils.PrintBanner(cfg.AppName(), "API started...\ngRPC started...")

				wg.Add(1)
				go runner.NewAPI(cfg, singleton).Go(context.Background(), &wg)

				wg.Add(1)
				go runner.NewGrpc(cfg, singleton).Go(context.Background(), &wg)

				wg.Wait()
				return nil
			},
		},
		{
			Name:  "api",
			Usage: "Start the API service",
			Action: func(c *cli.Context) error {
				var wg sync.WaitGroup
				utils.PrintBanner(cfg.AppName(), "API started...")

				wg.Add(1)
				go runner.NewAPI(cfg, singleton).Go(context.Background(), &wg)

				wg.Wait()
				return nil
			},
		},
		{
			Name:  "grpc",
			Usage: "Start the gRPC service",
			Action: func(c *cli.Context) error {
				var wg sync.WaitGroup
				utils.PrintBanner(cfg.AppName(), "gRPC started...")

				wg.Add(1)
				go runner.NewGrpc(cfg, singleton).Go(context.Background(), &wg)

				wg.Wait()
				return nil
			},
		},
	}
	if err := clientApp.Run(os.Args); err != nil {
		panic(err)
	}
}
