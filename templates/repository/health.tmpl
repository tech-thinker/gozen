package repository

import (
	"context"

	"gorm.io/gorm"

	"{{.PackageName}}/logger"
	"{{.PackageName}}/models"
	"{{.PackageName}}/profiler"
)

type HealthRepo interface {
	Ping(ctx context.Context) (bool, error)
}

type healthRepo struct {
	db *gorm.DB
	profiler profiler.Profiler
}

func (repo *healthRepo) Ping(ctx context.Context) (bool, error) {
	doc := models.Health{
		Success: true,
		Message: "Service is up and running.",
	}
	logger.Info(doc.Message)
	return true, nil
}

func NewHealthRepo(db *gorm.DB, profiler profiler.Profiler) HealthRepo {
	return &healthRepo{
		db: db,
		profiler: profiler,
	}
}
